0C4FBh 3AEFFF                           LD        A,(SYS_GODZ)
0C4FEh 32F9FE                           LD        (REJESTR_MIN_RAM+9),A; 3. Godzina
0C501h 3AEEFF                           LD        A,(SYS_MIN)
