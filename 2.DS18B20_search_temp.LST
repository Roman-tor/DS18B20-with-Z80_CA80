0C3ACh 3AEFFF                           LD        A,(SYS_GODZ)
0C3AFh 32F2FE                           LD        (REJESTR_MIN_RAM+2),A; 3. Godzina
0C3B2h 3AEEFF                           LD        A,(SYS_MIN)
0C3B5h 32F3FE                           LD        (REJESTR_MIN_RAM+3),A; 4. Minuta
0C3B8h                                            
0C3B8h 3AB2FE                           LD        A,(NR_CZUJNIKA)
0C3BBh 32F4FE                           LD        (REJESTR_MIN_RAM+4),A; 5. Numer czujnika (Pewny odczyt z RAM 0xFDB2)
0C3BEh                                            
