0C3E3h                                            
0C3E3h 3AB2FE                           LD        A,(NR_CZUJNIKA)
0C3E6h 32FBFE                           LD        (REJESTR_MAX_RAM+4),A; 5. Numer czujnika (Pewny odczyt z RAM 0xFDB2)
0C3E9h                                            
