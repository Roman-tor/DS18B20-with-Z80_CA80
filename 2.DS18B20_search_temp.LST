0C3EFh                                            
0C3EFh 3AB1FE                           LD        A,(MSB_TEMP)
0C3F2h 32FDFE                           LD        (REJESTR_MAX_RAM+6),A; 7. MSB temperatury MAX (Pewny odczyt z RAM 0xFDB1)
0C3F5h C9                               RET       
0C3F6h                                            
0C3F6h                                                           ; ==============================================================================
0C3F6h                                                           ; KOMPLETNA PROCEDURA: SPRAWDZ_KLAWIATURE (WERSJA Z PODWÓJNYM EKRANEM)
0C3F6h                                                           ; Najpierw pokazuje temperaturê przez 4s, potem czas przez kolejne 4s.
