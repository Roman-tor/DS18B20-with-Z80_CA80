00000h                                                           ; ==============================================================================
00000h                                                           ; BLOK 1: SZUKAJ_ROM (Algorytm WG Maxim AN187 ze sprawdzaniem sumy kontrolnej CRC)
00000h                                                           ; ==============================================================================  
00000h                                                           ; ZMIENNE W RAM CA80
00000h            DEVICE_COUNT:         EQU       0FD60H         ; Oficjalny licznik urz¹dzeñ wymagany przez projekt
00000h            LICZBA_CZUJNIKOW:     EQU       0FD61H         ; Lokalny licznik przebiegu pêtli algorytmu
00000h            OSTATNIA_ROZBIEZNOSC: EQU       0FD62H         ; Pozycja ostatniej wykrytej rozbie¿noœci (0-64)
00000h            OSTATNIE_ZERO:        EQU       0FD63H         ; Pomocnicza pozycja œcie¿ki zerowej
00000h            FLAGA_OSTATNIEGO:     EQU       0FD64H         ; Znacznik zakoñczenia sprawdzania ca³ego drzewa ID
00000h            BIEZACY_WSKAZNIK:     EQU       0FD65H         ; 16-bitowy wskaŸnik zapisu kolejnego ID pod NR_ID
00000h            TYMCZASOWY_ID:        EQU       0FD67H         ; 8-bajtowy bufor na aktualnie budowany numer seryjny
00000h            NR_ID:                EQU       0FD70H         ; TU ZAPISUJ ODCZYTANE BAJTY NUMERU SERYJNEGO
00000h            SENSOR1_ROM:          EQU       NR_ID          ; WskaZnik na adres ROM pierwszego czujnika w RAM
00000h                                            
00000h            LOW:                  EQU       80H            ; STAN NISKI - L
00000h            HIGH:                 EQU       82H            ; STAN WYSOKI - H
00000h            CTRL:                 EQU       0E3H           ; SLOWO KONTROLNE 8255
00000h            PORT_DS:              EQU       0E1H           ; TU PODLACZONY DS18B20   port B (PB0)
00000h            PRINT:                EQU       01D4H          ; WYSWIETL KOMUNIKAT WG (HL)
00000h                                            
00000h                                  ORG       #C000
0C000h                                            
0C000h            SZUKAJ_ROM_START:               
0C000h CDBCC1                           CALL      NMI_OFF        ; Zablokowanie przerwañ NMI na czas komunikacji      
0C003h                                                           ;  czyszczenie zmiennych w RAM przed startem (likwidacja smieci)
0C003h AF                               XOR       A
0C004h 3260FD                           LD        (DEVICE_COUNT),A
0C007h 3261FD                           LD        (LICZBA_CZUJNIKOW),A
0C00Ah 3262FD                           LD        (OSTATNIA_ROZBIEZNOSC),A
0C00Dh 3263FD                           LD        (OSTATNIE_ZERO),A
0C010h 3264FD                           LD        (FLAGA_OSTATNIEGO),A
0C013h                                            
0C013h                                                           ; Ustawienie pocz¹tkowego wskaŸnika zapisu unikalnych ID (0FD70h)
0C013h 2170FD                           LD        HL,NR_ID
0C016h 2265FD                           LD        (BIEZACY_WSKAZNIK),HL
0C019h                                            
0C019h            PETLA_GLOWNA_SZUKANIA:          
0C019h                                                           ; Jeœli flaga ostatniego urz¹dzenia jest ustawiona, koñczymy szukanie
0C019h 3A64FD                           LD        A,(FLAGA_OSTATNIEGO)
0C01Ch A7                               AND       A
0C01Dh C2D5C0                           JP        NZ,KONIEC_SZUKANIA
0C020h                                            
0C020h                                                           ; --- Krok 1: Sygna³ Reset i test Presence ---
0C020h CD0FC1                           CALL      OW_RESET
0C023h A7                               AND       A              ; Czy A = 0? (0 oznacza wykrycie obecnoœci czujnika)
0C024h C2D5C0                           JP        NZ,KONIEC_SZUKANIA; Jeœli brak odpowiedzi, koñczymy pracê
0C027h                                            
0C027h                                                           ; --- Krok 2: Wys³anie komendy SEARCH ROM (0xF0) ---
0C027h 3EF0                             LD        A,0F0H
0C029h CD2DC1                           CALL      OW_ZAPISZ_BAJT
0C02Ch                                            
0C02Ch                                                           ; --- Krok 3: Inicjalizacja zmiennych pêtli bitowej (64 bity) ---
0C02Ch AF                               XOR       A
0C02Dh 3263FD                           LD        (OSTATNIE_ZERO),A
0C030h 4F                               LD        C,A            ; C = indeks aktualnego bajtu ID (0 do 7)
0C031h 1601                             LD        D,1            ; D = maska bitowa w bajcie (bit 0)
0C033h                                            
0C033h                                                           ; Wyczyszczenie bufora TYMCZASOWY_ID w RAM 
0C033h                                                           ; Wyczyszczenie 8 bajtów TYMCZASOWY_ID
0C033h 2167FD                           LD        HL,0FD67H
0C036h 0608                             LD        B,8
0C038h AF                               XOR       A
0C039h            P1:                             
0C039h 77                               LD        (HL),A
0C03Ah 23                               INC       HL
0C03Bh 10FC                             DJNZ      P1
0C03Dh                                            
0C03Dh 0640                             LD        B,64           ; Licznik 64 bitów dla PETLA_BITOWA
0C03Fh 1E01                             LD        E,1            ; E = Numer bie¿¹cego bitu (1 do 64)
0C041h                                            
0C041h            PETLA_BITOWA:                   
0C041h C5                               PUSH      BC             ; Zachowaj licznik bitów (B) i indeks bajtu (C)
0C042h                                            
0C042h                                                           ; Odczyt pierwszego bitu (w³aœciwego)
0C042h CD58C1                           CALL      OW_ODCZYTAJ_BIT
0C045h 67                               LD        H,A            ; H = bit w³aœciwy
0C046h                                            
0C046h                                                           ; Odczyt drugiego bitu (zanegowanego)
0C046h CD58C1                           CALL      OW_ODCZYTAJ_BIT
0C049h 6F                               LD        L,A            ; L = bit zanegowany
0C04Ah                                            
0C04Ah                                                           ; Analiza stanów bitów wed³ug noty Maxim AN187
0C04Ah 7C                               LD        A,H
0C04Bh A7                               AND       A
0C04Ch C2D0C0                           JP        NZ,SPRAWDZ_CZY_J00; rozbieznosc
0C04Fh                                            
0C04Fh 7D                               LD        A,L
0C050h A7                               AND       A
0C051h 201E                             JR        NZ,SCIEZKA_ZERO; H=0, L=1 -> Wszystkie urz¹dzenia maj¹ tu bit 0
0C053h                                            
0C053h                                                           ; Przypadek H=0, L=0 -> Rozbie¿noœæ (czêœæ czujników ma 0, czêœæ 1)
0C053h 7B                               LD        A,E
0C054h 47                               LD        B,A
0C055h 3A62FD                           LD        A,(OSTATNIA_ROZBIEZNOSC)
0C058h B8                               CP        B
0C059h 3812                             JR        C,WYBIERZ_ZERO
0C05Bh 281A                             JR        Z,WYBIERZ_JEDEN
0C05Dh                                            
0C05Dh D5                               PUSH      DE
0C05Eh 2167FD                           LD        HL,TYMCZASOWY_ID
0C061h C5                               PUSH      BC
0C062h 0600                             LD        B,0
0C064h 09                               ADD       HL,BC
0C065h C1                               POP       BC
0C066h 7E                               LD        A,(HL)
0C067h A2                               AND       D
0C068h D1                               POP       DE
0C069h 200C                             JR        NZ,SCIEZKA_JEDEN
0C06Bh 1804                             JR        SCIEZKA_ZERO
0C06Dh                                            
0C06Dh            WYBIERZ_ZERO:                   
0C06Dh 7B                               LD        A,E
0C06Eh 3263FD                           LD        (OSTATNIE_ZERO),A
0C071h                                            
0C071h            SCIEZKA_ZERO:                   
0C071h AF                               XOR       A
0C072h CD70C1                           CALL      OW_ZAPISZ_BIT
0C075h 1812                             JR        KONIEC_KROKU_BITU
0C077h                                            
0C077h            WYBIERZ_JEDEN:                  
0C077h            SCIEZKA_JEDEN:                  
0C077h 3E01                             LD        A,1
0C079h CD70C1                           CALL      OW_ZAPISZ_BIT
0C07Ch D5                               PUSH      DE
0C07Dh 2167FD                           LD        HL,TYMCZASOWY_ID
0C080h C5                               PUSH      BC
0C081h 0600                             LD        B,0
0C083h 09                               ADD       HL,BC
0C084h C1                               POP       BC
0C085h 7E                               LD        A,(HL)
0C086h B2                               OR        D
0C087h 77                               LD        (HL),A
0C088h D1                               POP       DE
0C089h                                            
0C089h            KONIEC_KROKU_BITU:              
0C089h C1                               POP       BC             ; Przywróæ licznik bitów i indeks bajtu
0C08Ah                                            
0C08Ah                                                           ; Aktualizacja maski bitowej D dla nastêpnego bitu w bajcie
0C08Ah CB22                             SLA       D
0C08Ch C292C0                           JP        NZ,SKOK_NAST_BIT
0C08Fh 1601                             LD        D,1
0C091h 0C                               INC       C
0C092h                                            
0C092h            SKOK_NAST_BIT:                  
0C092h 1C                               INC       E              ; Zwiêksz numer rozpatrywanego bitu (1-64)
0C093h 05                               DEC       B              ; Bezpieczna pêtla dekrementacji (zastêpuje DJNZ)
0C094h 20AB                             JR        NZ,PETLA_BITOWA
0C096h                                            
0C096h                                                           ; --- KROK WERYFIKACJI SUMY KONTROLNEJ CRC-8 ---
0C096h CDE1C0                           CALL      OBLICZ_CRC_ID
0C099h A7                               AND       A
0C09Ah C2BEC0                           JP        NZ,POMIN_BLEDNY_ROM; Jeœli wynik != 0, suma CRC jest niepoprawna! Odrzuæ czujnik.
0C09Dh                                            
0C09Dh                                                           ; Zapis pomyœlnie zweryfikowanego ID do bazy danych RAM (0FDA0h + ...)
0C09Dh C5                               PUSH      BC
0C09Eh 2167FD                           LD        HL,TYMCZASOWY_ID
0C0A1h 3A65FD                           LD        A,(BIEZACY_WSKAZNIK)
0C0A4h 5F                               LD        E,A
0C0A5h 3A66FD                           LD        A,(BIEZACY_WSKAZNIK+1)
0C0A8h 57                               LD        D,A            ; DE = Aktualna pozycja zapisu w RAM
0C0A9h 010800                           LD        BC,8
0C0ACh EDB0                             LDIR                     ; Skopiuj 8 bajtów kodu ID czujnika
0C0AEh 7B                               LD        A,E
0C0AFh 3265FD                           LD        (BIEZACY_WSKAZNIK),A
0C0B2h 7A                               LD        A,D
0C0B3h 3266FD                           LD        (BIEZACY_WSKAZNIK+1),A
0C0B6h C1                               POP       BC
0C0B7h                                            
0C0B7h                                                           ; Inkrementacja licznika sprawnie zweryfikowanych urz¹dzeñ
0C0B7h 3A61FD                           LD        A,(LICZBA_CZUJNIKOW)
0C0BAh 3C                               INC       A
0C0BBh 3261FD                           LD        (LICZBA_CZUJNIKOW),A
0C0BEh                                            
0C0BEh            POMIN_BLEDNY_ROM:               
0C0BEh                                                           ; Aktualizacja rozbie¿noœci dla kolejnego przejœcia algorytmu drzewa binarnego
0C0BEh 3A63FD                           LD        A,(OSTATNIE_ZERO)
0C0C1h 3262FD                           LD        (OSTATNIA_ROZBIEZNOSC),A
0C0C4h A7                               AND       A
0C0C5h C219C0                           JP        NZ,PETLA_GLOWNA_SZUKANIA
0C0C8h                                            
0C0C8h 3E01                             LD        A,1
0C0CAh 3264FD                           LD        (FLAGA_OSTATNIEGO),A
0C0CDh C319C0                           JP        PETLA_GLOWNA_SZUKANIA
0C0D0h                                            
0C0D0h            SPRAWDZ_CZY_J00:                
0C0D0h 7D                               LD        A,L
0C0D1h A7                               AND       A
0C0D2h 28A3                             JR        Z,SCIEZKA_JEDEN
0C0D4h                                            
0C0D4h C1                               POP       BC             ; Czyszczenie stosu w przypadku wykrycia b³êdu magistrali
0C0D5h                                            
0C0D5h            KONIEC_SZUKANIA:                
0C0D5h CDB3C1                           CALL      NMI_ON
0C0D8h 3A61FD                           LD        A,(LICZBA_CZUJNIKOW)
0C0DBh 3260FD                           LD        (DEVICE_COUNT),A; Zapis ostatecznego wyniku pod 0xFD60
0C0DEh C3CAC1                           JP        PETLA_WSZYSTKICH_CZUJNIKOW
0C0E1h                                            
0C0E1h                                                           ; ==============================================================================
0C0E1h                                                           ; PODPROGRAM OBLICZANIA SUMY KONTROLNEJ CRC-8 DALLAS/MAXIM
0C0E1h                                                           ; Wyjœcie: A = 00h (Sukces), A != 00h (B³¹d sumy kontrolnej)
0C0E1h                                                           ; ==============================================================================
0C0E1h            OBLICZ_CRC_ID:                  
0C0E1h                                                           ; SPRAWDZIMY, CZY PIERWSZY ODCZYTANY BAJT = 28H
0C0E1h 3A67FD                           LD        A,(TYMCZASOWY_ID)
0C0E4h FE00                             CP        0              ; PIERWSZY BAJT ID, np. DS18B20
0C0E6h 200C                             JR        NZ,OBL_CRC2
0C0E8h            OBL_CRC1:                                      ; PIERWSZY BAJT = 0 ERROR
0C0E8h CDB3C1                           CALL      NMI_ON
0C0EBh 21C1C1                           LD        HL,B_DS
0C0EEh CDD401                           CALL      PRINT
0C0F1h 80                               DEFB      80H
0C0F2h CF                               RST       8              ; CZEKAJ NA WCISNIECIE KLAWISZA
0C0F3h F7                               RST       30H            ; MONITOR CA80
0C0F4h            OBL_CRC2:                       
0C0F4h C5                               PUSH      BC
0C0F5h E5                               PUSH      HL
0C0F6h 2167FD                           LD        HL,TYMCZASOWY_ID
0C0F9h 0E08                             LD        C,8            ; Przetwarzamy 8 bajtów pobranego ID
0C0FBh AF                               XOR       A              ; Zerowanie akumulatora CRC (A = 0)
0C0FCh            PETLA_BAJTOW_CRC:               
0C0FCh AE                               XOR       (HL)           ; Operacja XOR z bie¿¹cym bajtem
0C0FDh 0608                             LD        B,8            ; Przetwarzamy 8 bitów wewn¹trz bajtu
0C0FFh            PETLA_BITOW_CRC:                
0C0FFh CB3F                             SRL       A              ; Przesuñ rejestr CRC w prawo, bit 0 l¹duje w Carry
0C101h 3002                             JR        NC,BIT_CRC_ZERO; Jeœli Carry = 0, pomiñ operacjê XOR
0C103h EE8C                             XOR       8CH            ; XOR z lustrzanym wielomianem Dallas (0x8C)
0C105h            BIT_CRC_ZERO:                   
0C105h 05                               DEC       B
0C106h 20F7                             JR        NZ,PETLA_BITOW_CRC
0C108h 23                               INC       HL             ; PrzejdŸ do nastêpnego bajtu
0C109h 0D                               DEC       C
0C10Ah 20F0                             JR        NZ,PETLA_BAJTOW_CRC
0C10Ch E1                               POP       HL
0C10Dh C1                               POP       BC
0C10Eh C9                               RET       
0C10Fh                                            
0C10Fh                                            
0C10Fh                                                           ; --- PROCEDURA RESETU ---
0C10Fh            OW_RESET:                       
0C10Fh 3E80                             LD        A,LOW          ; Wymuszenie stanu niskiego na PB0
0C111h D3E3                             OUT       (CTRL),A
0C113h 3E42                             LD        A,66           ; opoz. ok. 264 us
0C115h            PETLA_OP_RES1:                  
0C115h 3D                               DEC       A
0C116h 20FD                             JR        NZ,PETLA_OP_RES1
0C118h                                            
0C118h 3E82                             LD        A,HIGH         ; Zwolnienie linii (Stan wysoki przez Pull-up)
0C11Ah D3E3                             OUT       (CTRL),A
0C11Ch 3E09                             LD        A,9            ; opoz. ok. 36 us
0C11Eh            PETLA_OP_RES2:                  
0C11Eh 3D                               DEC       A
0C11Fh 20FD                             JR        NZ,PETLA_OP_RES2
0C121h                                            
0C121h DBE1                             IN        A,(PORT_DS)    ; Próbkowanie linii DQ
0C123h E601                             AND       01H
0C125h 47                               LD        B,A            ; Zachowanie stanu (0 = Presence, 1 = Brak)
0C126h                                            
0C126h 3E38                             LD        A,56           ; opoz. ok. 225 us
0C128h            PETLA_OP_RES3:                  
0C128h 3D                               DEC       A
0C129h 20FD                             JR        NZ,PETLA_OP_RES3
0C12Bh                                            
0C12Bh 78                               LD        A,B
0C12Ch C9                               RET       
0C12Dh                                            
0C12Dh                                                           ; --- PROCEDURA ZAPISU  BAJTU ---
0C12Dh            OW_ZAPISZ_BAJT:                 
0C12Dh C5                               PUSH      BC
0C12Eh 0608                             LD        B,8
0C130h            PETLA_ZAPISU_BAJTU:             
0C130h 1F                               RRA                      ; Przesuñ najm³odszy bit bajtu do flagi Carry
0C131h F5                               PUSH      AF
0C132h 380F                             JR        C,ZAPISZ_BIT_JEDEN
0C134h                                            
0C134h            ZAPISZ_BIT_ZERO:                
0C134h 3E80                             LD        A,LOW
0C136h D3E3                             OUT       (CTRL),A
0C138h 3E08                             LD        A,8            ; opoz. ok. 32 us               
0C13Ah            PETLA_OP_ZAP0:                  
0C13Ah 3D                               DEC       A
0C13Bh 20FD                             JR        NZ,PETLA_OP_ZAP0
0C13Dh 3E82                             LD        A,HIGH
0C13Fh D3E3                             OUT       (CTRL),A
0C141h 180F                             JR        KONIEC_ZAPISU_BITU
0C143h                                            
0C143h            ZAPISZ_BIT_JEDEN:               
0C143h 3E80                             LD        A,LOW
0C145h D3E3                             OUT       (CTRL),A
0C147h 00                               NOP       
0C148h 00                               NOP       
0C149h 3E82                             LD        A,HIGH
0C14Bh D3E3                             OUT       (CTRL),A
0C14Dh 3E08                             LD        A,8            ; opoz. ok. 32 us            
0C14Fh            PETLA_OP_ZAP1:                  
0C14Fh 3D                               DEC       A
0C150h 20FD                             JR        NZ,PETLA_OP_ZAP1
0C152h                                            
0C152h            KONIEC_ZAPISU_BITU:             
0C152h F1                               POP       AF
0C153h 05                               DEC       B
0C154h 20DA                             JR        NZ,PETLA_ZAPISU_BAJTU
0C156h C1                               POP       BC
0C157h C9                               RET       
0C158h                                            
0C158h                                                           ; --- PROCEDURA ODCZYTU POJEDYNCZEGO BITU ---
0C158h            OW_ODCZYTAJ_BIT:                
0C158h 3E80                             LD        A,LOW          ; Wymuszenie stanu niskiego (start szczeliny)
0C15Ah D3E3                             OUT       (CTRL),A
0C15Ch 00                               NOP       
0C15Dh 00                               NOP       
0C15Eh 3E82                             LD        A,HIGH         ; Zwolnienie linii
0C160h D3E3                             OUT       (CTRL),A
0C162h 00                               NOP       
0C163h 00                               NOP       
0C164h DBE1                             IN        A,(PORT_DS)    ; Próbkowanie portu przed up³ywem 15 us
0C166h E601                             AND       01H
0C168h 47                               LD        B,A
0C169h 3E07                             LD        A,7            ; opoz. ok. 28 us              
0C16Bh            PETLA_OP_ODC:                   
0C16Bh 3D                               DEC       A
0C16Ch 20FD                             JR        NZ,PETLA_OP_ODC
0C16Eh 78                               LD        A,B
0C16Fh C9                               RET       
0C170h                                            
0C170h                                                           ; --- PROCEDURA ZAPISU POJEDYNCZEGO BITU ---
0C170h            OW_ZAPISZ_BIT:                  
0C170h E601                             AND       01H
0C172h 200E                             JR        NZ,ZAPISZ_POJEDYNCZY_JEDEN
0C174h                                            
0C174h 3E80                             LD        A,LOW
0C176h D3E3                             OUT       (CTRL),A
0C178h 3E08                             LD        A,8            ; opoz. ok. 32 us
0C17Ah            PETLA_BIT_Z0:                   
0C17Ah 3D                               DEC       A
0C17Bh 20FD                             JR        NZ,PETLA_BIT_Z0
0C17Dh 3E82                             LD        A,HIGH
0C17Fh D3E3                             OUT       (CTRL),A
0C181h C9                               RET       
0C182h                                            
0C182h            ZAPISZ_POJEDYNCZY_JEDEN:
0C182h                                            
0C182h 3E80                             LD        A,LOW
0C184h D3E3                             OUT       (CTRL),A
0C186h 00                               NOP       
0C187h 00                               NOP       
0C188h 3E82                             LD        A,HIGH
0C18Ah D3E3                             OUT       (CTRL),A
0C18Ch 3E08                             LD        A,8            ; opoz. ok. 32 us
0C18Eh            PETLA_BIT_Z1:                   
0C18Eh 3D                               DEC       A
0C18Fh 20FD                             JR        NZ,PETLA_BIT_Z1
0C191h C9                               RET       
0C192h                                            
0C192h                                                           ; --- PODPROGRAMY POMOCNICZE ---
0C192h            OW_WYSLIJ_ADRES_ROM:            
0C192h C5                               PUSH      BC
0C193h 0E08                             LD        C,8
0C195h            PETLA_WYSYLANIA_ROM:            
0C195h 7E                               LD        A,(HL)
0C196h E5                               PUSH      HL
0C197h CD2DC1                           CALL      OW_ZAPISZ_BAJT
0C19Ah E1                               POP       HL
0C19Bh 23                               INC       HL
0C19Ch 0D                               DEC       C
0C19Dh 20F6                             JR        NZ,PETLA_WYSYLANIA_ROM
0C19Fh C1                               POP       BC
0C1A0h C9                               RET       
0C1A1h                                            
0C1A1h            OW_ODCZYTAJ_BAJT:               
0C1A1h C5                               PUSH      BC
0C1A2h 0E08                             LD        C,8
0C1A4h AF                               XOR       A
0C1A5h            PETLA_ODCZYTU_BAJTU:            
0C1A5h F5                               PUSH      AF
0C1A6h CD58C1                           CALL      OW_ODCZYTAJ_BIT
0C1A9h 47                               LD        B,A
0C1AAh F1                               POP       AF
0C1ABh CB18                             RR        B
0C1ADh 1F                               RRA       
0C1AEh 0D                               DEC       C
0C1AFh 20F4                             JR        NZ,PETLA_ODCZYTU_BAJTU
0C1B1h C1                               POP       BC
0C1B2h C9                               RET       
0C1B3h                                            
0C1B3h            NMI_ON:                                        ; ENABLE NMI wlacz przerwania NMI /obsluga NMI trwa min. ok. 130 uS
0C1B3h 3E07                             LD        A,7            ; ; stan H  ; opoznienia NIE MOGA wykorzystywac HALT i innych procedur zwiazanych z NMI!!!
0C1B5h D3F9                             OUT       (0F9H),A       ; ustaw bit PC4 port 8255 /systemowego/ na "1"
0C1B7h 3EFA                             LD        A,0FAH
0C1B9h D3F9                             OUT       (0F9H),A
0C1BBh C9                               RET       
0C1BCh                                            
0C1BCh            NMI_OFF:                                       ; wylacz przerwania NMI - DISABLE NMI
0C1BCh 3E03                             LD        A,3            ; stan L, ustaw bit PC4 na "0"
0C1BEh D3F9                             OUT       (0F9H),A
0C1C0h C9                               RET       
0C1C1h                                                           ; brak czujnika 
