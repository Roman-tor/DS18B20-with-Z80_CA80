0C343h                                            
0C343h                                                           ; Ustaw flagê inicjalizacji na 55h, aby trwale zablokowaæ tê sekcjê
0C343h 3E55                             LD        A,55H
0C345h 32FEFE                           LD        (REJESTR_MAX_RAM+7),A
0C348h C395C3                           JP        KONIEC_REJESTRACJI
0C34Bh                                            
0C34Bh                                                           ; ==============================================================================
0C34Bh                                                           ; 1. BLOK SPRAWDZANIA GLOBALNEGO MINIMUM
0C34Bh                                                           ; ==============================================================================
0C34Bh            POROWNAJ_Z_MINIMUM:             
0C34Bh                                                           ; Wczytanie dotychczasowego rekordowego MINIMUM do HL prosto z 0xFEF5/6
0C34Bh 3AF5FE                           LD        A,(REJESTR_MIN_RAM+5)
0C34Eh 6F                               LD        L,A
0C34Fh 3AFDFE                           LD        A,(REJESTR_MAX_RAM+6)
0C352h 67                               LD        H,A            ; HL = Dotychczasowe Minimum
0C353h                                            
0C353h                                                           ; £adujemy temperaturê bie¿¹cego czujnika do DE
0C353h 3AB0FE                           LD        A,(LSB_TEMP)
0C356h 5F                               LD        E,A
0C357h 3AB1FE                           LD        A,(MSB_TEMP)
0C35Ah 57                               LD        D,A            ; DE = Bie¿¹ca temperatura
0C35Bh                                            
0C35Bh                                                           ; Test MINIMUM: (Bie¿¹ca - Stare_MIN) -> (DE - HL)
0C35Bh D5                               PUSH      DE
0C35Ch B7                               OR        A              ; Czyszczenie Carry
0C35Dh EB                               EX        DE,HL          ; HL = Bie¿¹ca, DE = Stare_MIN
0C35Eh ED52                             SBC       HL,DE          ; HL = Bie¿¹ca - Stare_MIN
0C360h D1                               POP       DE
0C361h                                            
0C361h                                                           ; Jeœli wynik dodatni lub zero (P), bie¿¹ca temperatura nie jest ni¿sza.
0C361h                                                           ; Pomijamy zapis minimum i przechodzimy do testu maksimum.
0C361h F272C3                           JP        P,TEST_MAKSIMUM
0C364h                                            
0C364h                                                           ; --- ZAPIS NOWEGO REKORDU MINIMUM (WYKONA SIÊ GDY DE < MIN) ---
0C364h 7B                               LD        A,E
0C365h 32F5FE                           LD        (REJESTR_MIN_RAM+5),A; Zapisz nowe LSB bezpoœrednio pod 0xFEF5
0C368h 7A                               LD        A,D
0C369h 32F6FE                           LD        (REJESTR_MIN_RAM+6),A; Zapisz nowe MSB bezpoœrednio pod 0xFEF6
0C36Ch                                            
