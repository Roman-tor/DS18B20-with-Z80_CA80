0C24Dh CDF6C3                           CALL      SPRAWDZ_KLAWIATURE
0C250h                                            
0C250h C1                               POP       BC             ; Przywróæ licznik BC ze stosu
0C251h 0B                               DEC       BC
0C252h 78                               LD        A,B
0C253h B1                               OR        C
0C254h C243C2                           JP        NZ,PETLA_10S_DLA_KLAWIATURY; Powtarzaj, a¿ minie pe³ne 10 sekund
0C257h                                            
0C257h                                                           ; --- KROK E: Sprawdzenie warunku koñca pêtli czujników ---
0C257h 3A60FD                           LD        A,(DEVICE_COUNT); Odczytaj stan DEVICE_COUNT
0C25Ah 47                               LD        B,A            ; B = Ca³kowita liczba znalezionych urz¹dzeñ
0C25Bh 3AB2FE                           LD        A,(NR_CZUJNIKA); aktualnie mierzony wyswietlany
0C25Eh B8                               CP        B              ; Czy wyœwietlono ju¿ pomiar z ostatniego czujnika?
0C25Fh CACFC1                           JP        Z,PWC          ; Jeœli tak, zamknij cykl i zacznij od nowa
0C262h                                            
0C262h                                                           ; Przejœcie do kolejnego urz¹dzenia na liœcie
0C262h 3C                               INC       A
0C263h 32B2FE                           LD        (NR_CZUJNIKA),A; Zwiêksz numer czujnika na pozycji CYF7
0C266h                                            
