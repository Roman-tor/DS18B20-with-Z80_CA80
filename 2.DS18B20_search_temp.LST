0C372h 3AFCFE                           LD        A,(REJESTR_MAX_RAM+5)
0C375h 6F                               LD        L,A
0C376h 3AFDFE                           LD        A,(REJESTR_MAX_RAM+6)
0C379h 67                               LD        H,A            ; HL = Dotychczasowe Maksimum
0C37Ah                                            
0C37Ah                                                           ; Œwie¿e za³adowanie temperatury bie¿¹cego czujnika do DE
0C37Ah 3AB0FE                           LD        A,(LSB_TEMP)
0C37Dh 5F                               LD        E,A
0C37Eh 3AB1FE                           LD        A,(MSB_TEMP)
0C381h 57                               LD        D,A            ; DE = Bie¿¹ca temperatura
0C382h                                            
0C382h                                                           ; Test MAKSIMUM: (Stare_MAX - Bie¿¹ca) -> (HL - DE)
0C382h D5                               PUSH      DE
0C383h B7                               OR        A              ; Czyszczenie Carry
0C384h ED52                             SBC       HL,DE          ; HL = Stare_MAX - Bie¿¹ca
0C386h D1                               POP       DE
0C387h                                            
0C387h                                                           ; Jeœli wynik dodatni lub zero (P), bie¿¹ca temperatura nie jest wy¿sza -> koniec.
0C387h F295C3                           JP        P,KONIEC_REJESTRACJI
0C38Ah                                            
0C38Ah                                                           ; --- ZAPIS NOWEGO REKORDU MAKSIMUM (WYKONA SIÊ GDY DE > MAX) ---
0C38Ah 7B                               LD        A,E
