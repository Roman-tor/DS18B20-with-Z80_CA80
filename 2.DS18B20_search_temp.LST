0C3C7h 32F6FE                           LD        (REJESTR_MIN_RAM+6),A; 7. MSB temperatury MIN (Pewny odczyt z RAM 0xFDB1)
0C3CAh C9                               RET       
0C3CBh                                            
0C3CBh                                                           ; --- BEZWZGLÊDNY ZAPIS REJESTRU MAKSIMUM (0xFEF7 - 0xFEFD) ---
