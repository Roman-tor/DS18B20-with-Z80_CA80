0C48Dh                                            
0C48Dh                                                           ; ==============================================================================
0C48Dh                                                           ; PODPROGRAM POMOCNICZY: PRZYGOTUJ_I_WYSWIETL_DATETIME
0C48Dh                                                           ; Mapuje Datê i Czas w uk³adzie: DDMM GG.M bezpoœrednio do rejestrów LED CA80
0C48Dh                                                           ; ==============================================================================
0C48Dh            PRZYGOTUJ_I_WYSWIETL_DATETIME:
0C48Dh                                            
0C48Dh E5                               PUSH      HL
0C48Eh D5                               PUSH      DE
0C48Fh C5                               PUSH      BC
0C490h                                            
0C490h                                                           ; --- 1. DZIEN (Komórka [HL]) -> CYF7 (0xFFFE) i CYF6 (0xFFFD) ---
0C490h 7E                               LD        A,(HL)         ; Pobierz bajt dnia ze stempla:0xFEF0
0C491h DF                               RST       18H
0C492h 26                               DEFB      26H
0C493h 23                               INC       HL             ; HL wskazuje na Miesi¹c 0xFEF1
0C494h                                            
0C494h                                                           ; --- 2. MIESIAC (Komórka [HL]) -> CYF5 (0xFFFC) i CYF4 (0xFFFB) ---
0C494h 7E                               LD        A,(HL)         ; Pobierz bajt miesi¹ca 
0C495h DF                               RST       18H
0C496h 24                               DEFB      24H
0C497h 23                               INC       HL             ; HL wskazuje na Godzinê 0xFEF2
0C498h                                            
0C498h                                                           ; --- 3. CYF3 (0xFFFA) -> WYGASZENIE (Separator wizualny w œrodku ekranu) ---
0C498h AF                               XOR       A
0C499h 32FAFF                           LD        (CYF3),A       ; CYF3 = 00h (Pusty, ciemny segment)
0C49Ch                                            
0C49Ch                                                           ; --- 4. MINUTA (Komórka [HL]) -> CYF0 (0xFFF7) ---
0C49Ch 23                               INC       HL             ; 0xFEF3
0C49Dh 7E                               LD        A,(HL)         ; Pobierz bajt minut
0C49Eh                                                           ; CALL ROZBIJ_NA_DWIE_CYFRY
0C49Eh 1F                               RRA       
0C49Fh 1F                               RRA       
0C4A0h 1F                               RRA       
0C4A1h 1F                               RRA       
0C4A2h DF                               RST       18H            ; WYSW. REJ. A
0C4A3h 10                               DEFB      10H
0C4A4h                                            
0C4A4h                                                           ; --- 5. GODZINA (Komórka [HL]) -> CYF2 (0xFFF9) i CYF1 (0xFFF8) ---
0C4A4h 2B                               DEC       HL             ; 0xFEF1
0C4A5h 7E                               LD        A,(HL)         ; Pobierz bajt godziny
0C4A6h DF                               RST       18H
0C4A7h 21                               DEFB      21H
0C4A8h 3AF8FF                           LD        A,(CYF1)
0C4ABh F680                             OR        80H
0C4ADh                                                           ; Zapal bit 7 (kropka dziesiêtna) jako separator czasu
0C4ADh 32F8FF                           LD        (CYF1),A       ; CYF1 = Jednoœci godziny z kropk¹
0C4B0h                                            
0C4B0h C1                               POP       BC
0C4B1h D1                               POP       DE
0C4B2h E1                               POP       HL
0C4B3h C9                               RET       
0C4B4h                                            
0C4B4h                                                           ; ==============================================================================
0C4B4h                                                           ; PODPROGRAM POMOCNICZY: OPOZN_4_SEK (Z zachowaniem odœwie¿ania NMI)
0C4B4h                                                           ; ==============================================================================
0C4B4h            OPOZN_2_SEK:                    
0C4B4h F5                               PUSH      AF
0C4B5h C5                               PUSH      BC
0C4B6h D5                               PUSH      DE
0C4B7h 0E02                             LD        C,2            ; 2 * 1 sekunda = 4s
0C4B9h            PETLA_2S_Z:                     
0C4B9h 0664                             LD        B,100          ; 100 * 10 ms = 1 sekunda
0C4BBh            PETLA_2S_INTERN:                
0C4BBh 113505                           LD        DE,1333
0C4BEh            PETLA_2S_DELAY:                 
0C4BEh 1B                               DEC       DE
0C4BFh 7A                               LD        A,D
0C4C0h B3                               OR        E
0C4C1h C2BEC4                           JP        NZ,PETLA_2S_DELAY
0C4C4h 05                               DEC       B
0C4C5h C2BBC4                           JP        NZ,PETLA_2S_INTERN
0C4C8h 0D                               DEC       C
0C4C9h C2B9C4                           JP        NZ,PETLA_2S_Z
0C4CCh D1                               POP       DE
0C4CDh C1                               POP       BC
0C4CEh F1                               POP       AF
0C4CFh C9                               RET       
0C4D0h                                                           ; BEZPOŒREDNIE PODPROGRAMY POMOCNICZE STEMPLOWANIA CZASU DLA ASIDE
0C4D0h                                                           ; Pewny, bezwzglêdny zapis struktur do pamiêci RAM bez u¿ywania rejestru HL
