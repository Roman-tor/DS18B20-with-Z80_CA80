0C200h                                            
0C200h                                                           ; Odczekanie 750 ms na zakoñczenie pomiaru przez ten konkretny uk³ad
0C200h 064B                             LD        B,75           ; 750 ms dotyczy odzielczosci 12-bit, jesli mniejsza, mozna zmniejszyc
0C202h            PETLA_KONV_G:                   
0C202h 113505                           LD        DE,1333
