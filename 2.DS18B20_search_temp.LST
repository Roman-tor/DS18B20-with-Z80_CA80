0C3F8h D5                               PUSH      DE
0C3F9h E5                               PUSH      HL
0C3FAh                                            
0C3FAh                                                           ; Wywo³anie systemowej procedury skanowania klawiatury CA80
0C3FAh CDC3FF                           CALL      CSTS           ; Wynik wraca bezpoœrednio w rejestrze A
0C3FDh                                            
0C3FDh FE0D                             CP        0DH            ; klawisz " D "
0C3FFh CA0AC4                           JP        Z,POKAZ_REKORD_MIN
0C402h                                            
0C402h FE0F                             CP        0FH            ; klawisz " F "
0C404h CA40C4                           JP        Z,POKAZ_REKORD_MAX
0C407h                                            
0C407h C388C4                           JP        KONIEC_KLAWIATURY
0C40Ah                                            
0C40Ah            POKAZ_REKORD_MIN:               
