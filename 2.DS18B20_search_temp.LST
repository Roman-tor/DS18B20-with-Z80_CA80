0C399h C9                               RET       
0C39Ah                                            
0C39Ah                                                           ; --- PODPROGRAM POMOCNICZY: ZAPIS STEMPLA (BEZ ZMIAN) ---
0C39Ah            ZAPISZ_STEMPEL_CZASU:           
0C39Ah                                                           ; Sprawdzamy na bazie m³odszego bajtu rejestru L, czy obs³ugujemy MIN czy MAX
0C39Ah 7D                               LD        A,L
0C39Bh FEF0                             CP        0F0H           ; Jeœli L = F0h, stemplujemy rejestr MIN
0C39Dh C2CBC3                           JP        NZ,STEMPLUJ_MAX
0C3A0h                                            
0C3A0h                                                           ; --- BEZWZGLÊDNY ZAPIS REJESTRU MINIMUM (0xFEF0 - 0xFEF6) ---
