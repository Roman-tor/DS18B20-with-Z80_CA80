0C434h 21F0FE                           LD        HL,REJESTR_MIN_RAM;0FEF0H         ; HL wskazuje na pocz¹tek stempla MIN (Dzieñ)
0C437h CD8DC4                           CALL      PRZYGOTUJ_I_WYSWIETL_DATETIME
