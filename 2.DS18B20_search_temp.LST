0C410h 3AB1FE                           LD        A,(MSB_TEMP)
0C413h 32B7FE                           LD        (KOPIA_MSB),A
0C416h 3AB2FE                           LD        A,(NR_CZUJNIKA)
0C419h 32B8FE                           LD        (KOPIA_NUMERU),A
0C41Ch                                            
0C41Ch                                                           ; --- KROK 2: WYŒWIETLENIE SAMEJ TEMPERATURY MIN (Przez 4 sekundy) ---
0C41Ch 3AF5FE                           LD        A,(REJESTR_MIN_RAM+5); £adujemy LSB temperatury MIN
