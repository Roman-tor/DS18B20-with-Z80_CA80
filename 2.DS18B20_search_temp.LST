0C290h 7C                               LD        A,H
0C291h 2F                               CPL       
0C292h 67                               LD        H,A
0C293h 7D                               LD        A,L
0C294h 2F                               CPL       
0C295h 6F                               LD        L,A
0C296h 23                               INC       HL
0C297h                                            
